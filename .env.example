# Bearer token that Claude (or other MCP clients) must send to authenticate to this server.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_SERVER_AUTH_TOKEN=changeme-generate-a-secure-random-value

# Bearer token this server sends to the slack-patron upstream API
SLACK_PATRON_API_TOKEN=your-upstream-bearer-token

# Base URL of the slack-patron upstream API (no trailing slash)
SLACK_PATRON_BASE_URL=https://your-slack-patron-instance.example.com

# Port for the Express server
PORT=29112
